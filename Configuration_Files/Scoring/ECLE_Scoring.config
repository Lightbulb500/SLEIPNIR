#############################################################################
# This configuration file configures the properties required for each spectral line to score
# Read by Config_Readers.scoring_configuration_reader
#
# HOW SCORING WORKS: each line in Line_Lists.lines_for_scoring() that passes every cut below adds to the candidate score:
#   +2 for each of [FeVII]6088, [FeX]6376, [FeXI]7894 and [FeXIV]5304
#   +1 for each of [FeVII]3759, [FeVII]5160 and [FeVII]5722 - but only if [FeVII]6088 has itself been detected
# which gives the maximum of 11 below (candidate_score_max must be updated if the scoring lines or their points change).
# Candidate_Flag in the results file: 1 = score reaches the threshold; 2 = reaches it and has a 'strong' iron line;
# 5 = below the threshold but has a 'strong' iron line; 7 = none of those, but at least two FeVII lines reach the weak FeVII SNR cut; 0 = not a candidate.
#############################################################################

[Scoring Definition]
# Any object with a candidate score equal to or exceeding this value will be treated as an ECLE candidate
# This is the base threshold without any modifiers
# NB: the analysis lowers it by 2 for objects where [FeXI]7894 is not covered by the spectrum (including when the spectrum ends inside its continuum windows)
candidate_threshold = 5

# Maximum possible candidate score
candidate_score_max = 11

#############################################################################
# Regions to cut out of the spectrum around the lines
# First in wavelength space (assumed to be angstroms), then in velocity space (assumed to be km/s)
#############################################################################
[Region Cutout]

# NB: Only the velocity space cut is used at present (SLEIPNIR runs in 'Shift' mode) - the wavelength values are read but have no effect
lower_wave_region = 125
upper_wave_region = 125

# The region around each line (relative to its rest wavelength) that is cut out for the continuum fit and measurements
lower_velocity_shift = -7000
upper_velocity_shift = 5000

#############################################################################
# Line Regions
#############################################################################
[Line Regions]

# To qualify as a line detection for candidate selection the maximum flux point of the feature must occur
# within this +/- km/s of the zero velocity point. Also the region used when measuring the line parameters
line_region = 350

# The detected feature must be the strongest within this +/- km/s of the zero velocity point
feature_region = 800


#############################################################################
# Line Detection
#############################################################################
[Line Detection]

# To qualify as a line detection for candidate selection the overall feature pEQW must exceed this value:
# NB: pEQW is negative for emission, so 'exceed' means the pEQW must be at or below this (more negative) value. Must be negative.
line_detection_peqw_threshold = -1.5

# To qualify as a line detection for candidate selection the maximum flux point of the feature must exceed this value
# (in units of the fitted continuum, i.e. 1.05 is 5% above the continuum)
line_detection_absolute_threshold = 1.05

# If the minimum of the line peak region falls below this value the line cannot score - designed to weed out very noisy lines not guaranteed to be caught by the standard SNR cuts
# (also in units of the fitted continuum)
line_peak_region_min_threshold = 0.7


################
# SNR Parameters:
# 'Local' is the number of standard deviations above (or below if -ve) the standard deviation of the continuum regions
# 'Spec' is relative to the error spectrum measurement of underlying uncertainty - NB: By default these cuts will apply relative to the 1 sigma flux error
################

# Line peak must exceed this local SNR value to be detected
relative_snr_threshold = 3

# The minimum acceptable local SNR value allowed within the line detection region for a line to be considered detected
min_relative_snr_threshold = -1

# If any part of the line detection region falls below this value (the 'Spec' per pixel SNR) the line will be rejected
espec_min_snr_threshold = 3

################
# Strong SNR parameters
# These are used to flag objects with single very strong lines, or FeVII features only, bypassing other requirements
################

# Line peak must exceed this local SNR value (and the 'Spec' minimum can't fall below it) to be considered strong
strong_relative_snr_threshold = 10

# Softer 'strong' SNR cut on the FeVII lines - at least two FeVII lines reaching this (locally and in 'Spec') flags the object (Candidate_Flag 7)
weak_fevii_snr_threshold = 5
