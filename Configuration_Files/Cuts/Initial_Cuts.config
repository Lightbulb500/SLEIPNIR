# Initial spectral pre-analysis cuts
# These can be overridden in the main scripts if the variables are redefined after the config processing
# Read by Config_Readers.cuts_configuration_reader, which returns (Low_z_Cut, High_z_Cut)
# Both values are also part of the Settings_Config string stored in the results file, so changing them means the analysis
# has to be re-run before SLEIPNIR_Plots will accept the results (unless its config check is disabled)

[Redshift]
# Controls the range of acceptable redshifts for spectra
#
# Low_z_Cut:  spectra need Redshift > Low_z_Cut (strictly greater). Helps to filter out stars and redshift errors.
#             Only applied to spectra that have NOT already been redshift corrected (Redshift_Corrected_Flag = 0 in the sample file)
# High_z_Cut: spectra need Redshift < High_z_Cut (strictly less). Applied to every spectrum. At higher redshifts more of the
#             spectral region of interest is shifted beyond the observable range, reducing reliability

Low_z_Cut = 0.01
High_z_Cut = 0.45
