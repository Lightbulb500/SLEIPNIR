# This configuration file controls which plots are generated by default by the analysis and main plots scripts along with some other controls
# These can be overridden in the main scripts if the variables are redefined after the config processing
# Read by Config_Readers.plotting_configuration_reader (currently returns just the one value below, as a single bool)

[Analysis Plots]

# If True - this tells the main analysis script to generate a sample map of all objects, which are possible targets and which have been selected for the analysis itself - This can be useful for investigating issues if certain sky regions are not behaving as expected
# NB: SLEIPNIR_Analysis currently draws a single RA / DEC scatter of the sample (Summary_Plots/SpecMap_for_<Sample_Name>.pdf)

Co_Ord_Summary_Plot = True
