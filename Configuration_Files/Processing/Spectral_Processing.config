# This configuration file controls the various spectral processing steps implemented into the SLEIPNIR ECLE detection scripts.
# These can be overridden in the main scripts if the variables are redefined after the config processing
# Read by Config_Readers.processing_configuration_reader (15 values, in the order they appear below)
#
# ORDER OF OPERATIONS in SLEIPNIR_Analysis:
#   0. Spectrum read in - the Galactic extinction and redshift corrections are applied here, BEFORE any of the steps below
#   1. Problematic skyline interpolation   (Skylines section)
#   2. Rebinning                           (Rebinning section)
#   3. Harsh skyline removal, then strong post-rebin skyline removal   (Skylines section)
#   4. Zero flux pixels are set to nan and every nan is linearly interpolated over - so no gaps remain after this point
#   5. FFT, then median filter, then Gaussian smoothing, then Savitzky-Golay  (in that order - NB: not the order of the sections below)
#   6. Telluric band masking, which sets flux to nan and so is the one step that leaves gaps (any line there cannot be measured)
# Anything switched on is applied; the steps are independent of one another.
#
# SETTINGS CONFIG: the rebinning / smoothing switches and values and the redshift cuts are encoded in the Settings_Config string
# stored in every results file. The skyline switches and telluric masking are NOT, so changing those does not trigger the
# configuration mismatch check in SLEIPNIR_Plots - re-run the analysis yourself if you change them.

#############################################################################
# Spectral Smoothing
#############################################################################
[Error Spec Inclusion]
# Intended: if active - and should be unless there is a good reason not to - the error spectrum will under go the same smoothing steps as the flux spectrum
# NB (review): this value is not currently read by Config_Readers or used by the analysis - at present only the Gaussian smoothing is applied to the error spectrum
Include_Error_Spec = True

[Rebinning]
# If active rebins the spectrum to a desired resolution of a given resolution in Angstroms
# The new wavelength grid has bin edges at multiples of the resolution. Pixels outside the original coverage are filled and then interpolated over (step 4)
rebin_active = True
rebin_resolution = 3

[Fast_Fourier_Transform]
# If active applies a FFT smoothing algorithm of a given threshold. Aimed at reducing any large erratic peaks e.g., from residual skylines
# The threshold is NOT a wavelength or a fraction of the spectrum: Fourier mode k has a 'frequency' of 50 * k whatever the spectrum length, and every mode
# with a frequency above the threshold is removed - i.e. modes with k > fft_threshold / 50 are cut. A spectrum with N pixels has modes up to N / 2, so for a
# rebinned spectrum of ~2000 pixels any threshold above ~50000 (such as the value below) removes nothing. Applied to the flux only.
fft_active = False
fft_threshold = 100000

[Gaussian_Smoothing]
# Applies Gaussian smoothing filter to the spectra of a desired sigma size (in pixels).
# While this is a very effective smoothing technique it does have the disadvantage of processing noise features into looking very similar to the desired narrow features which can lead to false positives
# Applied to the flux and the error spectrum
gaussian_smoothing_active = False
gaussian_sigma = 1

[Median_Filtering]
# Applies a median filtering algorithm (flux only)
# The kernel is in pixels and must be odd
median_filtering_active = False
median_filter_kernel = 3

[Savitzky_Golay_Filtering]
# Applies a Savitzky-Golay filter (flux only)
# The window is in pixels, must be odd, and must be larger than the polynomial order
sav_gol_active = False
sav_gol_window = 9
sav_gol_poly = 3

#############################################################################
# Skyline Removal
# All skyline positions are shifted to the rest frame of each object before use (see Line_Lists.sky_lines / problematic_skylines)
#############################################################################

[Skylines]
# If True spectra will have the worst of the skylines (4358, 5577, 6300, 7276 and 7630 Angstrom observed) interpolated over, +/- 8 Angstrom either side, before rebinning
Problematic_Skyline_Removal = True

# In ADDITION to the above (it does not replace it): after rebinning, the two pixels nearest to every skyline in the full list are removed and interpolated over
Harsh_Skyline_Removal = False

# Another aggressive skyline removal option that nan's out the six pixels nearest to each of the worst skylines post rebinning to attempt to remove any residual traces
Strong_Sky_Post_Rebin_Harsh_Removal = False

# If this masking is active any lines within the four most contaminated telluric bands (7790-8105, 8280-8665, 8760-9005 and 9310-9570 Angstrom observed) is masked out entirely and will never be used in detection scoring
# NB: this includes [FeXI]7894 for objects at redshifts where it falls in the first band
Mask_Telluric_Bands = False
